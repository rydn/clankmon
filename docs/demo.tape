# Record the README GIF with charmbracelet/vhs:  vhs docs/demo.tape
Output docs/demo.gif
Set FontSize 14
Set Width 1600
Set Height 900
Set Theme { "background": "#07080d", "foreground": "#c8cce0" }
Set TypingSpeed 40ms

Hide
Type "clankmon --demo"
Enter
Sleep 2.5s
Show
Sleep 4s
Type "s"
Sleep 1.5s
Type "2"
Sleep 3s
Type "j"
Sleep 1.5s
Type "3"
Sleep 2s
Type "/error"
Enter
Sleep 1.5s
Type "4"
Sleep 3s
Type "5"
Sleep 3s
Type "t"
Sleep 1.5s
Type "1"
Sleep 3s
Type "q"
Sleep 1s
